# Copiar a .env y rellenar. .env no se versiona.
# Si la clave lleva caracteres especiales (@ : / %), codifíquela para URL.
HIDRAL_DB_CLAVE=
# Secreto para firmar las sesiones: cadena larga y aleatoria, p. ej. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
HIDRAL_SECRETO=
HIDRAL_TOKEN_HORAS=12
# auto = OCR solo en páginas sin texto; off = nunca
HIDRAL_OCR=auto
HIDRAL_PUERTO=8000
TZ=Europe/Madrid
